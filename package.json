{
	"name": "jet",
	"version": "0.2.1",
	"private": true,
	"author": {
		"name": "Kent Phung",
		"email": "daikhanh9260@gmail.com",
		"url": "https://www.linkedin.com/in/kent-phung-9a5400220/"
	},
	"license": "MIT",
	"scripts": {
		"predev": "lsof -ti:2906 | xargs kill -9 2>/dev/null; true",
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/build.js",
		"start": "node dist/index.js",
		"serve": "npm run build && npm run start",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"arch:check": "archsafe --config archsafe.config.mts",
		"arch:baseline": "archsafe baseline --config archsafe.config.mts",
		"docs:dev": "npx --yes serve docs",
		"make:http": "node scripts/make/module.js http",
		"make:worker": "node scripts/make/module.js worker",
		"make:scheduler": "node scripts/make/module.js scheduler",
		"db:setup": "node scripts/db/setup.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:check": "drizzle-kit check",
		"db:status": "node scripts/db/status.js",
		"db:reset": "node scripts/db/reset.js",
		"db:test": "node scripts/db/check.js"
	},
	"dependencies": {
		"@event-bus-manager/core": "^0.2.2",
		"@fire-shield/core": "^3.1.1",
		"@fire-shield/hono": "^3.1.1",
		"@hono/node-server": "^2.1.0",
		"@hono/standard-validator": "^0.2.0",
		"@hono/swagger-ui": "^0.6.1",
		"@khapu2906/treasure-chest": "^1.5.0",
		"@standard-community/standard-json": "^0.3.5",
		"@standard-community/standard-openapi": "^0.2.9",
		"@valibot/to-json-schema": "^1.7.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"hono-openapi": "^1.3.1",
		"hono-rate-limiter": "^0.5.3",
		"jsonwebtoken": "^9.0.3",
		"meo-meo-logger": "^1.2.0",
		"node-schedule": "^2.1.1",
		"openapi-types": "^12.1.3",
		"pg": "^8.22.0",
		"tslib": "^2.8.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@archsafe/cli": "^0.1.0",
		"@archsafe/core": "^0.1.0",
		"@eslint/js": "^10.0.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.2.0",
		"@types/node-schedule": "^2.1.8",
		"@types/pg": "^8.21.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"javascript-obfuscator": "^5.5.0",
		"tsc-alias": "^1.9.1",
		"tsx": "^4.23.11",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.66.0"
	}
}

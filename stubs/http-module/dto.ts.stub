import * as v from "valibot";

export const Create__Name__Dto = v.object({
	name: v.pipe(v.string(), v.minLength(1)),
});
export type Create__Name__Type = v.InferOutput<typeof Create__Name__Dto>;

export const __Name__ResponseDto = v.object({
	id: v.string(),
	name: v.string(),
	createdAt: v.string(),
});
export type __Name__Response = v.InferOutput<typeof __Name__ResponseDto>;

export const __Name__ListResponseDto = v.array(__Name__ResponseDto);
